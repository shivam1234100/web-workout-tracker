# Copy to .env and fill in. Never commit the real .env.

# MongoDB connection string (MongoDB Atlas free M0 cluster works). Must include the database name.
DATABASE_URL=mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/ai-workout-tracker?retryWrites=true&w=majority

# Long random string used to sign login tokens. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=change-me

PORT=3000

# Set to "production" when deployed (disables showing password reset codes in API responses)
# NODE_ENV=production

# Comma-separated list of frontend URLs allowed by CORS
# FRONTEND_URL=https://web-workout-tracker.vercel.app

# Optional but recommended: free Google Gemini key for the AI Coach and Weekly Insights
# (get one at https://aistudio.google.com/apikey). Without it a rule-based offline coach answers.
# GEMINI_API_KEY=
# GEMINI_MODEL=gemini-3.6-flash

# Optional: emails password reset codes (https://resend.com)
# RESEND_API_KEY=re_...
